# Local database. The data directory is created automatically.
HOST=0.0.0.0
PORT=5302
DATABASE_URL=sqlite:///./data/tarkov.db

# Current supported tarkov.dev static data feed.
TARKOV_SOURCE_BASE_URL=https://json.tarkov.dev
TARKOV_GAME_MODE=regular
TARKOV_LANGUAGE=ru
TARKOV_TRANSLATION_LANGUAGES=ru,en,zh

# Synchronization interval. Set SYNC_ON_STARTUP=false for a fully manual mode.
SYNC_INTERVAL_SECONDS=3600
SYNC_ON_STARTUP=true
REQUEST_TIMEOUT_SECONDS=90

# Redis response cache. Every unique GET response is cached for one hour.
REDIS_CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_CACHE_PREFIX=eft-price-api:v1
REDIS_CACHE_MAX_RESPONSE_BYTES=25000000
REDIS_SOCKET_TIMEOUT_SECONDS=1

# Optional protection for POST /api/v1/sync. Leave empty only on a trusted network.
ADMIN_API_KEY=
